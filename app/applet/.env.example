# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# Web Push VAPID Keys (Render & Production deployment)
# Set these in your Render Environment Variables dashboard (never commit private keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Firebase Cloud Firestore (Persistent Push Storage across server restarts)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_FIRESTORE_DATABASE_ID=
